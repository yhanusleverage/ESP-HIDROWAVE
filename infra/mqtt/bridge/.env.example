# /opt/hidrowave-bridge/.env — NUNCA commitar valores reais
# Documentação: docs/mqtt/06_BRIDGE_MQTT_SUPABASE.md

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=bridge_internal
MQTT_PASS=Fox8gqya!

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Se heartbeat ausente por este tempo, marcar offline (ms)
HEARTBEAT_STALE_MS=120000

# Mínimo entre PATCHs de device_status (heartbeat) por device (ms) — ESP publica a cada 60s
HEARTBEAT_THROTTLE_MS=55000

# Mínimo entre INSERTs em hydro_measurements por device (ms) — MVP: 30000 (paralelo HTTPS)
TELEMETRY_THROTTLE_MS=30000

# Teste manual: npm run test:pub
TEST_DEVICE_ID=ESP32_HIDRO_269844
