; Copie para secrets.ini na raiz do projeto ESP-HIDROWAVE-main
; NUNCA commite secrets.ini (credenciais reais)

[secrets]
; --- Supabase (obrigatório) ---
supabase_url = https://YOUR_PROJECT.supabase.co
supabase_anon_key = eyJ...

; --- MQTT MVP telemetria (mqtt_enabled=0 até bridge validado) ---
mqtt_enabled = 0
mqtt_host = 15.175.109.90
mqtt_port = 1883
; User MQTT no firmware = mqtt_ + device_id (automático). Provisionar cada MAC:
;   sudo bash provision-device.sh ESP32_HIDRO_XXXXXX 'MESMA_SENHA'
mqtt_user = mqtt_ESP32_HIDRO_AUTO
mqtt_pass =

; 0 = bivalente: MQTT telemetry (hydro + ambiente) + HTTPS paralelo
; 1 = só MQTT; HTTPS hydro + environment_data se MQTT desconectado (fallback)
mqtt_hydro_only = 0

; Fase heartbeat: 1 = MQTT se broker OK; HTTPS device_status só se MQTT cair (igual hydro)
; 0 = bivalente: MQTT heartbeat + HTTPS updateDeviceStatus em paralelo
mqtt_health_only = 0
