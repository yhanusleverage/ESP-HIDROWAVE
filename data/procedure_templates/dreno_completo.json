{
  "id": "proc_full_drain",
  "name": "Dreno completo",
  "description": "Drena até nível baixo/vazio (L4 seco). Sem fill. Pausa Auto EC/pH (priority P1).",
  "enabled": true,
  "priority": 90,
  "rule_json": {
    "condition": {
      "type": "sensor_compare",
      "sensor": "water_level_ok",
      "op": "==",
      "value_min": 1
    },
    "script": {
      "instructions": [
        {
          "type": "relay_action",
          "role": "drain",
          "action": "on"
        },
        {
          "type": "wait_level",
          "sensor": "level_4",
          "op": "==",
          "value": "seco"
        },
        {
          "type": "relay_action",
          "role": "drain",
          "action": "off"
        }
      ]
    }
  }
}
